# ── Convex ───────────────────────────────────────────────────────────────
# Las crea "npx convex dev" la primera vez.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Ingesta del formulario publico ───────────────────────────────────────
# Secreto compartido entre el route handler de Next y la action de Convex.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe existir TAMBIEN como variable de entorno del despliegue de Convex.
INGEST_SECRET=

# Sal para el hash de IP. Misma generacion que arriba. Solo del lado de Next.
IP_SALT=

# ── Sitio ────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ── Correo de Alpha con Resend ──────────────────────────────────────────
# Estas variables viven en el despliegue de Convex. No son NEXT_PUBLIC_*.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Convex usa modo seguro por defecto. Cambiar a false solo tras verificar el dominio.
RESEND_TEST_MODE=true
ALPHA_CONTACT_EMAIL=contacto@alphaccm.org
ALPHA_AUTO_EMAIL=auto@alphaccm.org
